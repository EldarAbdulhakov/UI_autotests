<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SequentialSuite" parallel="tests" thread-count="2">
    <test name="Chrome Grid">
        <parameter name="browserName" value="chrome"/>
        <parameter name="useGrid" value="true"/>
        <classes>
            <class name="tests.RegistrationLoginPageTest"/>
            <class name="tests.MainPageTest"/>
        </classes>
    </test>

    <test name="Firefox Local">
        <parameter name="browserName" value="firefox"/>
        <parameter name="useGrid" value="false"/>
        <classes>
            <class name="tests.RegistrationLoginPageTest"/>
            <class name="tests.BankingTest"/>
        </classes>
    </test>

    <listeners>
        <listener class-name="utils.retry.RetryListener"/>
    </listeners>

</suite>
